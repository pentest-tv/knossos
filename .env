# Pentest.TV reward funnel (optional). Leave blank in the committed repo.
# Set KNOSSOS_CLAIM_PASS to the passphrase your Pentest.TV claim page expects to
# enable the escape-page reward. Do not commit the real value to a public repo.
KNOSSOS_CLAIM_PASS=
