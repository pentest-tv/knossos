BASE_DEBIAN=debian@sha256:5bc3287b25407c965a30f38e32603dc253a3869e1b12a21ac09bfc27fd8b13ce
BASE_KALI=kalilinux/kali-rolling@sha256:c717f201f29a7e0a9126c0d51bd08aa7194ac82f53c57314339182f92b0b1585

# Host ports.
WEB_PORT=8081
TTYD_PORT=7681

# Flag prefix used by the auto flag-init service.
FLAG_PREFIX=PENTESTTV
