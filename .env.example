# Copy to .env, then run scripts/pin-digests.sh (or .ps1) to fill the image lines with
# real digests. Commit the resulting .env so students deploy exactly these images.

# Image pins. These tags are placeholders; pin-digests replaces them with name@sha256.
TARGET_IMAGE=tleemcjr/metasploitable2:latest
DVWA_IMAGE=vulnerables/web-dvwa:latest
JUICE_IMAGE=bkimminich/juice-shop:latest
GOPHISH_IMAGE=gophish/gophish:latest
MAILHOG_IMAGE=mailhog/mailhog:latest
BIND_IMAGE=internetsystemsconsortium/bind9:9.20
MYSQL_IMAGE=mysql:8.4
POSTGRES_IMAGE=postgres:16
PYTHON_IMAGE=python:3.12-slim
BASE_DEBIAN=debian:stable-slim
BASE_KALI=kalilinux/kali-rolling:latest

# Sliver C2 release pinned for the C2 server and the Kali client (downloaded at build
# from GitHub; both must match). Bump together if you change it.
SLIVER_VERSION=v1.5.43

# Host ports.
WEB_PORT=8081
JUICE_PORT=3000
GOPHISH_ADMIN_PORT=3333
GOPHISH_PHISH_PORT=8088
MAILHOG_UI_PORT=8025
SCOREBOARD_PORT=8890
TTYD_PORT=7681
VNC_PORT=5901
INTRANET_PORT=8082
GIT_PORT=8083
WIKI_PORT=8084
SSO_PORT=8085

# Flag prefix used by the auto flag-init service.
FLAG_PREFIX=PENTESTTV

# Pentest.TV reward funnel (optional). Leave blank in the committed repo.
# Set KNOSSOS_CLAIM_PASS to the passphrase your Pentest.TV claim page expects to
# enable the escape-page reward. Do not commit the real value to a public repo.
KNOSSOS_CLAIM_PASS=
# KNOSSOS_CLAIM_URL=https://pentest.tv/knossos/claim
